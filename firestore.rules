rules_version = '2';

// 대나무숲 Firestore 보안 규칙
//
// 이 파일이 없던 동안에는 `allow read, write: if true` 가 적용되어 있었다.
// projectId 와 웹 API 키는 index.html 에 그대로 들어 있어 공개된 값이므로,
// 그 규칙에서는 누구나 REST API 로 고충 접수 전문과 AI API 키를 읽을 수 있었다.
//
// 핵심 전제: 관리자 여부는 admins/{uid} 문서의 존재로 판정한다.
// 앱의 관리자 로그인도 같은 조건을 보고 화면을 여닫지만, 실제 차단은 이 규칙이 한다.
// 화면 코드를 고쳐도 데이터에는 닿지 못한다.
//
// 적용: Firebase 콘솔 → Firestore Database → 규칙 에 붙여넣고 게시.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 관리자 명단. 콘솔에서 admins/{uid} 문서를 직접 만들어 등록한다.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 명단 자체는 클라이언트가 건드릴 수 없다. 읽기는 본인 문서만 허용해
    // 로그인 직후 "내가 관리자인가" 를 확인할 수 있게 한다.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /artifacts/{appId}/public/data/{collection}/{docId} {

      // ── 고충 접수(과거 데이터) ────────────────────────────────
      // 고충 접수는 사내 카카오톡 채널로 옮겨갔고 앱에는 접수·조회 화면이 없다.
      // 남아 있는 과거 건(complaint_cases)은 보존 대상이라 지우지 않지만,
      // 아래 어떤 규칙에도 이름이 나오지 않는다. 관리자는 isAdmin() 으로
      // 닿고, 그 외에는 기본 거부가 그대로 적용된다.

      // ── 조직 진단 응답 ────────────────────────────────────────
      // 익명 응답이므로 개별 열람 경로가 없다. 관리자만 읽는다.
      function isSurvey() { return collection == 'survey_responses'; }

      // ── AI 설정 ───────────────────────────────────────────────
      // API 키가 들어 있다. 관리자 외에는 읽을 수 없다.
      function isSecret() { return collection == 'app_settings'; }

      // ── 게시판 ────────────────────────────────────────────────
      function isBoard() { return collection in ['board_posts', 'board_comments']; }

      // ── 집계·운영 데이터 ──────────────────────────────────────
      // 대시보드와 진단 화면이 쓰는 통계. 개인 식별 정보가 없어 열람은 열어두고
      // 쓰기만 관리자로 제한한다.
      //
      // teams 는 팀 목록(조직 구조)이다. 기간이 없어 달이 바뀌어도 그대로 남는다.
      // 구성원의 진단 화면이 소속 부서를 고를 때 읽어야 하므로 열람은 열어둔다.
      function isStats() {
        return collection in ['global_stats', 'team_stats', 'chart_stats', 'action_items', 'teams'];
      }

      // ── 읽기 ──────────────────────────────────────────────────
      allow get: if isAdmin()
                 || isBoard()
                 || isStats();

      allow list: if isAdmin()
                  || isBoard()
                  || isStats();
      // 고충 접수 / 진단 응답 / AI 설정 은 읽기에서 전부 빠진다.
      // 목록을 훑는 순간 전체가 노출되므로 관리자에게만 남긴다.

      // ── 쓰기 ──────────────────────────────────────────────────
      // 진단 응답과 게시글 작성은 익명 사용자도 할 수 있어야 한다.
      allow create: if isAdmin()
                    || ((isSurvey() || isBoard()) && signedIn());

      // 수정: 게시판 공감·댓글수·신고 때문에 익명에게도 필요하다.
      // 다만 '반응' 필드만 열어둔다. hidden 과 blindCleared 는 블라인드를
      // 켜고 끄는 스위치라, 열어두면 신고당한 사람이 직접 해제해 신고 기능
      // 자체가 무의미해진다. 관리자만 손댈 수 있다.
      allow update: if isAdmin()
                    || (isBoard() && signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['likedBy', 'likeCount', 'commentCount',
                                       'reportedBy', 'reportCount']));

      // 삭제: 전부 관리자만.
      //
      // 게시판 글도 마찬가지다. 예전에는 로그인만 하면 남의 글도 지울 수 있었다.
      // 작성자 정보를 저장하지 않아 규칙이 본인을 판정할 수 없었기 때문인데,
      // 그 대신 화면에서만 막혀 있어 콘솔로는 누구나 게시판을 비울 수 있었다.
      // 이제 구성원의 삭제는 deleteBoardPost / deleteBoardComment 함수를 거친다.
      // 함수가 호출자 uid 로 익명 태그를 다시 계산해 작성자를 확인하고,
      // Admin SDK 로 동작하므로 이 규칙에 걸리지 않는다.
      allow delete: if isAdmin();
    }

    // ── 대나무숲이 쓰지 않는 컬렉션 ───────────────────────────
    // 이 Firebase 프로젝트는 다른 시스템과 함께 쓰이고 있다.
    // 규칙에 적히지 않은 경로는 전부 거부되므로, 여기에 남기지 않으면
    // hr_* 를 읽는 그 시스템이 이 규칙을 게시하는 순간 멈춘다.
    //
    // 그래서 일단 기존 동작(제한 없음)을 그대로 둔다. 이 규칙의 목적은
    // 고충 접수를 잠그는 것이고, 그 과정에서 남의 시스템을 깨뜨리지 않는 것이
    // 우선이기 때문이다.
    //
    // 다만 이 세 컬렉션은 여전히 외부에서 읽힌다. 특히
    // hr_people_registry 는 이름상 개인정보가 들어 있을 가능성이 높다.
    // 해당 시스템의 접속 방식이 확인되면 아래처럼 좁혀야 한다.
    //   · 브라우저에서 접속       → `if request.auth != null` 로 제한
    //   · 서버(Admin SDK)로 접속  → 규칙을 우회하므로 `if false` 로 잠가도 무방
    match /hr_departments/{document=**}     { allow read, write: if true; }
    match /hr_people_registry/{document=**} { allow read, write: if true; }
    match /hr_positions/{document=**}       { allow read, write: if true; }

    // 위에 적히지 않은 경로는 전부 거부된다(규칙이 없으면 기본 거부).
  }
}
